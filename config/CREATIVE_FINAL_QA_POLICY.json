{
  "schema": "momentwire-creative-final-qa-policy/v1",
  "contract_version": "MW-FINAL-PLAYBACK-QA-V1",
  "enabled": true,
  "renderer_input": {
    "video_start_max_seconds": 0.1,
    "audio_start_max_seconds": 0.1,
    "opening_freeze_reject_seconds": 0.3,
    "opening_window_seconds": 3.0
  },
  "final_render": {
    "video_start_max_seconds": 0.1,
    "audio_start_max_seconds": 0.1,
    "max_video_pts_gap_seconds": 0.05,
    "opening_window_seconds": 3.0,
    "opening_freeze_reject_seconds": 0.3,
    "whole_clip_freeze_reject_seconds": 0.75,
    "max_av_duration_skew_seconds": 0.2,
    "minimum_fps": 24.0,
    "freeze_detection_scope": "CENTERED_CONTENT_VIEWPORT",
    "content_aspect_ratio": "16:9",
    "source_aware_freeze_comparison": true,
    "source_freeze_match_tolerance_seconds": 0.2,
    "source_freeze_minimum_overlap_ratio": 0.6,
    "confirm_renderer_added_freeze": true,
    "renderer_added_freeze_confirmation_noise_db": -60.0
  },
  "required_editorial_checks": [
    "natural_start_verified",
    "natural_endpoint_verified",
    "no_weird_cuts_verified",
    "captions_not_truncated_verified",
    "caption_no_artificial_ellipsis_verified",
    "actual_final_render_reviewed"
  ],
  "publication_rule": "NO_CANONICAL_INGEST_NO_DRIVE_FINAL_NO_PUBLICATION_UNTIL_FINAL_QA_PASS"
}
